{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build AIOne QT Quick frontend",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/default-Vulkan",
                "--target",
                "AIOneQT",
                "--"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build AIOne QT Widgets frontend",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/default-Vulkan",
                "--target",
                "AIOneQTWidgets",
                "--"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        }
    ]
}